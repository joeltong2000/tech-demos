# Optional: point the MCP server at a real JDE EnterpriseOne AIS server.
# Leave everything unset (or no .env at all) for the offline mock mode —
# the demo happy path needs no credentials.

# Base URL of the AIS server, e.g. https://ais.example.com:9302
JDE_AIS_BASE_URL=

# E1 user credentials used for POST /jderest/v2/tokenrequest
JDE_AIS_USERNAME=
JDE_AIS_PASSWORD=

# E1 environment and role for the session
JDE_AIS_ENVIRONMENT=JDV920
JDE_AIS_ROLE=*ALL

# Web inspector port (default 9400)
PORT=9400
