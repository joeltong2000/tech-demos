# Agent Framework does NOT auto-load .env files.
# For Python live mode, call load_dotenv() (already wired when AF_CHAT_MODE=openai).
# For .NET, read these via Environment.GetEnvironmentVariable / IConfiguration yourself.

# Default for this demo (no keys, deterministic CI):
AF_CHAT_MODE=scripted

# --- Optional live providers (NOT required to run the demo) ---
# Set AF_CHAT_MODE=openai and provide ONE of the blocks below, then extend
# CreateChatClient() / create_chat_client() using the skill provider tables:
#
# .NET (from agent-framework-builder-dotnet / agent-builder.md):
#   Microsoft.Agents.AI.OpenAI + OpenAI (or Azure.AI.OpenAI)
#   ResponsesClient.AsAIAgent(...)  or  ChatClient.AsAIAgent(...)
#
# Python (from agent-framework-builder-python / agent-builder.md):
#   agent-framework-openai
#   OpenAIChatClient(...)           # Responses semantics
#   OpenAIChatCompletionClient(...) # Chat Completions semantics

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Azure OpenAI / Foundry Models (example)
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# Foundry project (skill's preferred sample path)
# FOUNDRY_PROJECT_ENDPOINT=https://YOUR_ACCOUNT.services.ai.azure.com/api/projects/YOUR_PROJECT
# FOUNDRY_MODEL=gpt-5.4-mini
