# Default is mock mode: a local mock AIS server is started in-process and no
# credentials are needed. To point the demo at a REAL JD Edwards AIS server,
# set MOCK=false and fill in the values below (copy this file to .env first).

# "true" (default) = run against the built-in mock AIS server.
# "false" = run against a real AIS server using the settings below.
MOCK=true

# Base URL of the AIS server, e.g. https://ais.example.com:7078
# (the demo appends /jderest/v3/orchestrator/<name> to this).
AIS_BASE_URL=http://localhost:9208

# Basic-auth credentials for the AIS server. Never commit real values.
AIS_USERNAME=DEMO
AIS_PASSWORD=change-me

# Name of the orchestration to invoke, and its input payload as JSON.
ORCHESTRATION_NAME=ORCH_DemoSlowLookup
ORCHESTRATION_INPUT_JSON={"orderNumber":"12345"}

# Mock-only: how long the simulated orchestration takes, in milliseconds.
MOCK_ORCH_DURATION_MS=4000

# Mock-only: port the mock AIS server listens on (bun run mock).
MOCK_PORT=9208
