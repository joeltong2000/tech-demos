# Optional: enable a real OpenAI-compatible chat model instead of the
# offline scripted mock. Leave unset (or empty) to stay fully offline.
#
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# DEMO_LLM=mock   # force mock even if a key is present
# DEMO_LLM=openai # require OpenAI-compatible client
