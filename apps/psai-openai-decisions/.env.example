# All variables are OPTIONAL. The default happy path is mock mode and needs
# no credentials at all.

# --- Real mode (optional) ---------------------------------------------------
# To run against the live OpenAI Decisions API instead of the local mock,
# set BOTH of these. Live calls cost money and are never required here.
#OPENAI_API_KEY=sk-...
#PSAI_MODE=real

# --- Mock mode tuning (optional) --------------------------------------------
# Port for the local mock Decisions API (default 4100).
#PSAI_MOCK_PORT=4100
# Full endpoint override passed to the module's -Endpoint parameter.
#PSAI_DECISIONS_ENDPOINT=http://127.0.0.1:4100/v1/decisions
