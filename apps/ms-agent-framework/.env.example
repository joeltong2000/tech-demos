# All variables are OPTIONAL. With no .env at all, the demo runs fully offline
# using a deterministic scripted planner in place of the LLM — tools and the
# agent loop are still the real Microsoft Agent Framework machinery.

# Set to use a real LLM (OpenAI) for planning and composing the briefing.
OPENAI_API_KEY=

# Model used in OpenAI mode (default: gpt-4o-mini).
OPENAI_CHAT_MODEL_ID=gpt-4o-mini

# Point at any OpenAI-compatible endpoint (leave empty for api.openai.com).
OPENAI_BASE_URL=

# Port for the web server (default: 8787).
PORT=8787
